---
interface Props {
  value?: string;
  placeholder: string;
  size?: "hero" | "page";
  action?: string;
}
const { value = "", placeholder, size = "hero", action = "/search/" } = Astro.props;
---
<form class:list={["sf", `sf-${size}`]} action={action} method="get" role="search">
  <label class="visually-hidden" for={`q-${size}`}>Search open listings</label>
  <svg class="sf-icon" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="10" cy="10" r="7" fill="none" stroke="currentColor" stroke-width="1.6" />
    <path d="M15.5 15.5 22 22" stroke="currentColor" stroke-width="1.6" />
  </svg>
  <input
    id={`q-${size}`}
    name="q"
    type="search"
    value={value}
    placeholder={placeholder}
    autocomplete="off"
    spellcheck="false"
    data-search-input
  />
  <kbd class="sf-kbd" aria-hidden="true">/</kbd>
  <button class="sf-go" type="submit" aria-label="Search">
    <span aria-hidden="true">→</span>
  </button>
</form>

<script is:inline>
  document.addEventListener("keydown", function (e) {
    if (e.key !== "/" || e.metaKey || e.ctrlKey) return;
    var t = e.target;
    if (t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.isContentEditable)) return;
    var el = document.querySelector("[data-search-input]");
    if (el) { e.preventDefault(); el.focus(); }
  });
</script>

<style>
  .sf {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    border-bottom: 2px solid var(--ink);
    transition: border-color 0.2s;
  }
  .sf::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: -2px;
    height: 2px;
    background: var(--long);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease);
  }
  .sf:focus-within::after { transform: scaleX(1); }
  .sf-icon { flex: none; color: var(--ink-2); }
  input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    font-family: var(--serif);
    font-weight: 350;
    letter-spacing: -0.015em;
    padding: 14px 0;
    outline: none;
    -webkit-appearance: none;
    appearance: none;
  }
  input::placeholder { color: var(--ink-3); font-style: italic; opacity: 1; }
  input::-webkit-search-cancel-button { display: none; }
  .sf-hero input { font-size: clamp(22px, 3vw, 34px); }
  .sf-page input { font-size: clamp(26px, 4vw, 44px); }
  .sf-kbd { display: none; }
  @media (min-width: 720px) { .sf-kbd { display: inline-block; } }
  .sf:focus-within .sf-kbd { opacity: 0; }
  .sf-go {
    flex: none;
    width: 46px; height: 46px;
    border-radius: 50%;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    font-size: 20px;
    cursor: pointer;
    transition: transform 0.3s var(--ease);
  }
  .sf-go:hover { transform: rotate(-45deg); }
</style>
