---
/**
 * Icon component - inline SVG icons
 * Uses Lucide icon names
 */

interface Props {
  name: string;
  size?: number;
  class?: string;
  'aria-hidden'?: boolean | 'true' | 'false';
}

const { name, size = 16, class: className = '', 'aria-hidden': ariaHidden = true } = Astro.props;

