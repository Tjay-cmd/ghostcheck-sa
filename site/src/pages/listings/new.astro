---
/**
 * New listings page - static list of fresh listings
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import ListingCard from '@/components/ListingCard.astro';
import EmptyState from '@/components/EmptyState.astro';
import { getAllListings } from '@/lib/data';
import { getChipLabels } from '@/lib/format';

const listings = getAllListings().filter(l => l.age_state === 'fresh');
const sortedListings = listings.sort((a, b) => 
  new Date(b.first_seen).getTime() - new Date(a.first_seen).getTime()
);

const chipLabels = getChipLabels();
---

<BaseLayout title="New Listings" description="Recently added job listings">
  <div class="listings-page">
    <div class="container">
      <h1>New Listings</h1>
      <p class="page-subtitle">
        {chipLabels.new} · {sortedListings.length} listings
      </p>
      
      {sortedListings.length === 0 ? (
        <EmptyState
          icon="calendar-clock"
          heading="No new listings right now"
          message="Check back soon for newly posted jobs."
        />
      ) : (
        <div class="listings-grid">
          {sortedListings.map((listing) => (
            <ListingCard listing={listing} showEmployer={true} />
          ))}
        </div>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .listings-page {
    padding: var(--s-6) 0;
  }

  .page-subtitle {
    font-size: var(--fs-base);
    line-height: var(--lh-base);
    color: var(--c-text-muted);
    margin-bottom: var(--s-6);
  }

  .listings-grid {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
</style>
