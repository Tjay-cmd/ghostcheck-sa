---
/**
 * Home page - shows recent listings with search (client-side)
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import ListingCard from '@/components/ListingCard.astro';
import EmptyState from '@/components/EmptyState.astro';
import { getAllListings, getSiteData } from '@/lib/data';
import { getChipLabels } from '@/lib/format';

const site = getSiteData();
const allListings = getAllListings();

// Sort by newest first_seen, take first 25
const recentListings = allListings
  .sort((a, b) => new Date(b.first_seen).getTime() - new Date(a.first_seen).getTime())
  .slice(0, 25);

const chipLabels = getChipLabels();
---

<BaseLayout title="GhostCheck SA" description="Track how long South African employer job listings have been up">
  <div class="home-page">
    <div class="container">
      <div class="home-intro">
        <h1>How long has that job been up?</h1>
        <p class="home-subtitle">
          We check South African employer career pages every day and show how long each listing has been up, and whether it's been posted before.
        </p>
      </div>
      
      <!-- Search will be added later as a JS island -->
      <div class="search-placeholder">
        <div class="search-input-placeholder">
          <span class="search-icon">🔍</span>
          <span class="search-text">Search available below (JavaScript required)</span>
        </div>
      </div>
      
      <div class="results-header">
        <p class="results-count">
          {site.counts.open_listings} open listings · {site.counts.employers_tracked} employers
        </p>
      </div>
      
      {recentListings.length === 0 ? (
        <EmptyState
          icon="calendar-clock"
          heading="We're collecting our first listings"
          message="GhostCheck checks employer career pages once a day. Check back soon."
        />
      ) : (
        <div class="listings-grid">
          {recentListings.map((listing) => (
            <ListingCard listing={listing} showEmployer={true} />
          ))}
        </div>
      )}
      
      <div class="browse-links">
        <h2>Browse without searching</h2>
        <ul class="browse-list">
          <li><a href="/listings/new/">New listings</a></li>
          <li><a href="/listings/open-90-plus/">Open 90+ days</a></li>
          <li><a href="/listings/reposted/">Reposted</a></li>
          <li><a href="/employers/">All employers A–Z</a></li>
        </ul>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .home-page {
    padding: var(--s-6) 0;
  }

  .home-intro {
    margin-bottom: var(--s-6);
  }

  .home-intro h1 {
    font-size: var(--fs-xl);
    line-height: var(--lh-xl);
    margin-bottom: var(--s-3);
  }

  .home-subtitle {
    font-size: var(--fs-base);
    line-height: var(--lh-base);
    color: var(--c-text-muted);
    max-width: 60ch;
  }

  .search-placeholder {
    margin-bottom: var(--s-5);
  }

  .search-input-placeholder {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: 8px;
    height: 48px;
    font-size: var(--fs-base);
    color: var(--c-text-muted);
  }

  .search-icon {
    font-size: 20px;
  }

  .results-header {
    margin-bottom: var(--s-4);
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--c-border-subtle);
  }

  .results-count {
    font-size: var(--fs-sm);
    line-height: var(--lh-sm);
    color: var(--c-text-muted);
    margin: 0;
  }

  .listings-grid {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .browse-links {
    margin-top: var(--s-7);
    padding-top: var(--s-6);
    border-top: 1px solid var(--c-border-subtle);
  }

  .browse-links h2 {
    font-size: var(--fs-lg);
    line-height: var(--lh-lg);
    margin-bottom: var(--s-4);
  }

  .browse-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .browse-list li {
    margin: 0;
  }

  .browse-list a {
    display: flex;
    align-items: center;
    padding: var(--s-3) var(--s-4);
    background: var(--c-surface);
    border: 1px solid var(--c-border-subtle);
    border-radius: 8px;
    color: var(--c-text);
    text-decoration: none;
    min-height: 44px;
    transition: border-color 0.2s;
  }

  .browse-list a:hover {
    border-color: var(--c-border);
  }

  .browse-list a::after {
    content: '›';
    margin-left: auto;
    font-size: 24px;
    color: var(--c-text-muted);
  }

  @media (min-width: 640px) {
    .browse-list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--s-3);
    }
  }
</style>
